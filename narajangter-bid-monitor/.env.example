# ============================================================
# 나라장터 입찰 모니터링 시스템 - 환경변수 설정
# 이 파일을 .env 로 복사한 뒤 값을 채워 넣으세요. (.env는 git에 커밋되지 않습니다)
# ============================================================

# ---- 공공데이터포털(data.go.kr) API 키 -----------------------
# data.go.kr에서 아래 두 API를 각각 "활용신청" 해야 합니다.
#   - 조달청_나라장터 입찰공고정보서비스 (BidPublicInfoService)
#   - 조달청_나라장터 사전규격정보서비스 (HrcspSsstndrdInfoService)
# 승인 후 마이페이지 > 개발계정 상세보기에서 발급되는 키 중
# 반드시 "일반 인증키 (Decoding / 평문)" 값을 사용하세요.
# ("Encoding" 키를 넣으면 URL 인코딩이 이중으로 적용되어
#  SERVICE_KEY_IS_NOT_REGISTERED_ERROR 가 발생할 수 있습니다.)
NARA_BID_SERVICE_KEY=
# 사전규격 API 키가 입찰공고 API 키와 동일하면 비워두세요(자동으로 위 키를 재사용합니다).
NARA_PRESTD_SERVICE_KEY=

# ---- API 엔드포인트 (버전 변경 시에만 수정) --------------------
# data.go.kr이 스키마를 개정하며 서비스 버전을 올리는 경우(BidPublicInfoService04 등)
# 아래 값으로 덮어쓸 수 있습니다. 비워두면 기본값을 사용합니다.
NARA_BID_BASE_URL=
NARA_PRESTD_BASE_URL=

# ---- 조회 옵션 --------------------------------------------------
# 이번 실행에서 조회할 기간(일). 매주 월요일 실행 기준 7일 권장.
LOOKBACK_DAYS=7
# 페이지당 조회 건수 (data.go.kr 권장 최대치 근처)
API_NUM_OF_ROWS=999
# 무한 루프 방지용 최대 페이지 수
API_MAX_PAGES=40
# 요청 타임아웃(ms). data.go.kr이 월요일 아침 등 피크 시간대에 느려질 수 있어 여유있게 설정
API_TIMEOUT_MS=30000
# 요청 실패 시 재시도 횟수
API_MAX_RETRIES=4
# 재시도 시 기본 대기시간(ms, 지수 백오프의 기준값)
API_RETRY_DELAY_MS=1500
# 연속 요청 사이 최소 간격(ms) - data.go.kr TPS 제한 보호용
API_REQUEST_INTERVAL_MS=300

# ---- 리포트/발송 옵션 -------------------------------------------
# 매칭 결과가 0건이어도 "이번 주 매칭 공고 없음" 리포트를 보낼지 여부
SEND_EMPTY_REPORT=true
# 조회/발송 중 오류가 발생하면 수신자에게 오류 알림 메일을 보낼지 여부
ALERT_EMAIL_ON_FAILURE=true
# true로 설정하면 실제 이메일을 보내지 않고 콘솔 출력 + output/ 폴더에 HTML만 저장합니다.
DRY_RUN=false
# debug | info | warn | error
LOG_LEVEL=info

# ---- SMTP 발신 계정 ----------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 465 포트 사용 시 true, 587(STARTTLS) 사용 시 false
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# 발신자 표시 이름/주소. 미설정 시 SMTP_USER를 사용합니다.
SMTP_FROM="나라장터 입찰 모니터링 <noreply@example.com>"

# ---- 텔레그램 알림 (선택) -----------------------------------------
# 봇 토큰과 수신 chat_id가 모두 채워져 있으면 자동으로 켜집니다.
# 이메일 발송을 대체하는 게 아니라, 이메일과 나란히 함께 보냅니다.
#
# 1) 텔레그램에서 @BotFather 와 대화 → /newbot → 봇 이름/아이디 입력 →
#    "123456789:AAH..." 형태의 토큰을 받아 아래에 넣으세요.
TELEGRAM_BOT_TOKEN=
# 2) 알림을 받을 대상의 chat_id. 쉼표로 여러 개 넣을 수 있습니다.
#    - 개인에게 보내려면: 그 사람이 먼저 봇에게 아무 메시지나 1회 보내야 합니다
#      (텔레그램은 봇이 먼저 말을 거는 것을 막아둡니다).
#    - 그룹에 보내려면: 봇을 그룹에 초대한 뒤 그룹에 아무 메시지나 보내세요. 그룹 id는 음수입니다(예: -1001234567890).
#    - chat_id 확인: npm run test:telegram 을 실행하면 봇에게 말을 건 사람들의 chat_id를 출력해줍니다.
TELEGRAM_CHAT_IDS=
# 토큰/수신자를 지운 채로 두지 않고 일시적으로만 끄고 싶을 때 false로 설정하세요.
TELEGRAM_ENABLED=true

# ---- 구글 시트 피드백 기록 (선택) --------------------------------
# 매 실행마다 매칭된 공고를 시트에 한 줄씩 쌓아두고, 담당자가 "판정" 열에
# O/X를 채워 넣으면 그게 다음 규칙 개선의 근거가 됩니다.
# 서비스 계정 JSON과 시트 ID가 모두 있어야 켜집니다.
#
# 1) Google Cloud Console → 프로젝트 생성 → "Google Sheets API" 사용 설정
# 2) 사용자 인증 정보 → 서비스 계정 만들기 → 키(JSON) 생성 후 다운로드
# 3) 받은 JSON 파일 내용을 "통째로 한 줄"로 아래에 넣으세요 (따옴표로 감쌉니다)
# 4) 스프레드시트를 열어 그 JSON 안의 client_email 주소에 "편집자" 권한으로 공유
GOOGLE_SERVICE_ACCOUNT_JSON=
# 스프레드시트 URL의 /d/ 와 /edit 사이 문자열
# 예) https://docs.google.com/spreadsheets/d/[여기가_ID]/edit
FEEDBACK_SHEET_ID=
# 기록할 탭 이름. 없으면 자동 생성됩니다.
FEEDBACK_SHEET_NAME=피드백
# 설정을 지우지 않고 잠시만 끄고 싶을 때 false
FEEDBACK_SHEET_ENABLED=true
